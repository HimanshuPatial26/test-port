    "capture": "node scripts/capture.mjs"
  },
  "dependencies": {
    "@fontsource-variable/urbanist": "^5.3.0",
    "three": "~0.186.0"
  },
  "devDependencies": {
    "@types/three": "~0.186.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.6"
  }
}
